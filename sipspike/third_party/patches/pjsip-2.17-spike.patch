+/* Optional single-host override. See pj_set_getaddrinfo_override(). */
+static char         pj_override_host[PJ_MAX_HOSTNAME];
+static pj_sockaddr  pj_override_addr;
+static int          pj_override_on;
+
+PJ_DEF(pj_status_t) pj_set_getaddrinfo_override(const char *host,
+                                                 const pj_sockaddr *addr)
+{
+    if (!host || !host[0] || !addr) {
+        pj_override_on = 0;
+        pj_override_host[0] = '\0';
+        return PJ_SUCCESS;
+    }
+    if (strlen(host) >= sizeof(pj_override_host))
+        return PJ_ENAMETOOLONG;
+
+    memcpy(pj_override_host, host, strlen(host) + 1);
+    pj_memcpy(&pj_override_addr, addr, sizeof(pj_override_addr));
+    pj_override_on = 1;
+    return PJ_SUCCESS;
+}
+
+static int pj_override_host_match(const pj_str_t *nodename)
+{
+    char tmp[PJ_MAX_HOSTNAME];
+
+    if (!pj_override_on || !nodename || !nodename->ptr)
+        return 0;
+    if (nodename->slen <= 0 || nodename->slen >= (int)sizeof(tmp))
+        return 0;
+    memcpy(tmp, nodename->ptr, nodename->slen);
+    tmp[nodename->slen] = '\0';
+    return strcasecmp(tmp, pj_override_host) == 0;
+}
